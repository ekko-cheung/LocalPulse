{
  "name": "localpulse-ui",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write src index.html vite.config.js",
    "format:check": "prettier --check src index.html vite.config.js",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "@tauri-apps/cli": "^2.5.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,css}": "prettier --write",
    "{index.html,vite.config.js}": "prettier --write"
  }
}
